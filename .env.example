# Flickr API Credentials (get from https://www.flickr.com/services/apps/create/)
FLICKR_API_KEY=your_api_key_here
FLICKR_API_SECRET=your_api_secret_here

# Optional: Flickr User ID (auto-detected if not set)
# FLICKR_USER_ID=

# Data directory (default: ~/.flickr-autotagger)
# DATA_DIR=~/.flickr-autotagger

# CLIP model (default: clip-vit-base-patch32)
# CLIP_MODEL=clip-vit-base-patch32

# Minimum confidence threshold for tags (0.0-1.0)
# TAG_THRESHOLD=0.25

# Maximum tags per photo
# MAX_TAGS_PER_PHOTO=15

# Download concurrency
# DOWNLOAD_CONCURRENCY=4

# Tag merge strategy: 'merge' (append) or 'replace'
# TAG_MERGE_STRATEGY=merge
